{
  "name": "databricks-forge",
  "version": "1.0.4",
  "description": "AI-powered use case discovery from Unity Catalog metadata -- turn your data estate into actionable insights",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/databricks-solutions/databricks-forge.git"
  },
  "homepage": "https://databricks-solutions.github.io/databricks-forge/",
  "bugs": {
    "url": "https://github.com/databricks-solutions/databricks-forge/issues"
  },
  "keywords": [
    "databricks",
    "unity-catalog",
    "ai",
    "use-case-discovery",
    "genie",
    "data-intelligence",
    "llm",
    "nextjs"
  ],
  "scripts": {
    "dev": "prisma generate && NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "build": "prisma generate && next build && node scripts/postbuild.mjs",
    "start": "node scripts/db-preflight.mjs && prisma db push --accept-data-loss && next start",
    "check:public": "node scripts/check-public-release.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:preflight": "node scripts/db-preflight.mjs",
    "test": "vitest run",
    "test:quality": "vitest run __tests__/genie/quality-evaluation.test.ts",
    "test:integration": "vitest run __tests__/db/migration-integration.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "prisma generate && tsc --noEmit",
    "seed:benchmarks": "node scripts/seed-benchmarks.mjs",
    "seed:benchmarks:all-industries": "FORGE_SEED_BENCHMARKS_ALL_INDUSTRIES=true node scripts/seed-benchmarks.mjs",
    "seed:benchmarks:industries": "FORGE_SEED_BENCHMARKS=true FORGE_SEED_BENCHMARK_INDUSTRIES=${FORGE_SEED_BENCHMARK_INDUSTRIES:-banking} node scripts/seed-benchmarks.mjs",
    "sync-master-repo": "node scripts/convert-master-repo.mjs",
    "seed:master-repo": "node scripts/seed/master-repo-full-load.mjs",
    "version:patch": "bash scripts/bump-version.sh patch",
    "version:minor": "bash scripts/bump-version.sh minor",
    "version:major": "bash scripts/bump-version.sh major"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@dagrejs/dagre": "^3.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "@tailwindcss/typography": "^0.5.19",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.39.0",
    "next": "16.2.4",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.76.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "uuid": "^14.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "prisma": "7.5.0",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@types/pg": "$@types/pg",
    "postcss": "^8.5.10",
    "hono": "^4.12.17",
    "@hono/node-server": "^1.19.13",
    "brace-expansion": "^2.0.3",
    "fast-uri": "^3.1.2"
  }
}
