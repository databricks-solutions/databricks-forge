model ForgeWafAssessment {
  assessmentId      String    @id @map("assessment_id")
  ownerEmail        String?   @map("owner_email")
  status            String    @default("pending")                     // pending | running | completed | failed
  scope             String?                                           // optional UC scope label
  triggeredBy       String?   @map("triggered_by")
  governanceScore   Float?    @map("governance_score")
  iuScore           Float?    @map("iu_score")
  oeScore           Float?    @map("oe_score")
  scpScore          Float?    @map("scp_score")
  reliabilityScore  Float?    @map("reliability_score")
  costScore         Float?    @map("cost_score")
  performanceScore  Float?    @map("performance_score")
  overallScore      Float?    @map("overall_score")
  totalControls     Int       @default(0) @map("total_controls")
  metControls       Int       @default(0) @map("met_controls")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")

  results ForgeWafControlResult[]

  @@index([createdAt])
  @@index([status])
  @@index([ownerEmail])
  @@map("forge_waf_assessments")
}

// Per-control result for a single assessment run.
model ForgeWafControlResult {
  id                  String   @id @default(uuid())
  assessmentId        String   @map("assessment_id")
  wafId               String   @map("waf_id")
  pillar              String
  scorePercentage     Float    @map("score_percentage")
  thresholdPercentage Float    @map("threshold_percentage")
  thresholdMet        Boolean  @map("threshold_met")
  evaluatedAt         DateTime @default(now()) @map("evaluated_at")

  assessment ForgeWafAssessment @relation(fields: [assessmentId], references: [assessmentId], onDelete: Cascade)
  control    ForgeWafControl    @relation(fields: [wafId], references: [wafId])

  @@unique([assessmentId, wafId])
  @@index([assessmentId])
  @@index([wafId])
  @@index([pillar])
  @@map("forge_waf_control_results")
}

// Workspace-level qualitative answer for a WAF control. One row per waf_id;
// reused across assessment runs (configuration-like, not run-scoped).
//   response: yes (100) | partial (50) | no (0) | not_applicable (excluded)
model ForgeWafQualitativeResponse {
  wafId        String   @id @map("waf_id")
  response     String                                       // yes | partial | no | not_applicable
  notes        String?
  respondedBy  String?  @map("responded_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("forge_waf_qualitative_responses")
}

// Workspace-level exclusion for a WAF control or a specific resource.
//   resourceType + resourceId NULL  -> the whole control is ignored across runs
//   resourceType + resourceId set   -> only that resource is ignored (e.g. an
//                                       idle warehouse intentionally kept warm)
// V1 honors the control-level case; resource-level is reserved for a follow-up.
model ForgeWafIgnoredResource {
  id            String   @id @default(uuid())
  wafId         String   @map("waf_id")
  resourceType  String?  @map("resource_type")              // e.g. "warehouse" | "table" | "job" | null
  resourceId    String?  @map("resource_id")
  reason        String
  ignoredBy     String?  @map("ignored_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([wafId, resourceType, resourceId])
  @@index([wafId])
  @@map("forge_waf_ignored_resources")
}

// ---------------------------------------------------------------------------
// App Configuration (singleton)
//
// Workspace-shared runtime feature flags that can be toggled from the Settings
// UI without redeploying the app. One fixed-id row (`"singleton"`); designed
// to grow into a generic feature-flag table as more runtime toggles are added.
//
// Demo Mode was historically gated by the `FORGE_DEMO_MODE_ENABLED` env var.
// On first read the env var seeds the row, after which the UI is the source
// of truth.
// ---------------------------------------------------------------------------

model ForgeAppConfig {
  id              String   @id @default("singleton")
  demoModeEnabled Boolean  @default(false) @map("demo_mode_enabled")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  @@map("forge_app_config")
}

// ---------------------------------------------------------------------------
// Portfolio Admins (org-admin allowlist for the cross-estate Portfolio tier)
//
// Workspace-shared, in-tool managed allowlist that supersedes the legacy
// `FORGE_ORG_ADMIN_EMAILS` env var (still honoured for back-compat). The
// deploying user is auto-seeded as a bootstrap admin (see deploy.sh /
// FORGE_PORTFOLIO_BOOTSTRAP_ADMIN) so the portfolio works with zero config;
// admins can then grant/revoke access to others from the UI without a
// redeploy. `email` is stored lower-cased and is the primary key.
// ---------------------------------------------------------------------------

model ForgePortfolioAdmin {
  email          String   @id
  grantedByEmail String?  @map("granted_by_email")
  isBootstrap    Boolean  @default(false) @map("is_bootstrap")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("forge_portfolio_admins")
}
