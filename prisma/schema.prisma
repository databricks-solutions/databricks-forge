model ForgeWafControl {
  wafId                  String   @id @map("waf_id")
  pillar                 String                                       // governance | interoperability_usability | operational_excellence | security_compliance_privacy | reliability | performance_efficiency | cost_optimisation
  pillarName             String   @map("pillar_name")                 // verbatim from CSV (e.g. "01 - Data And AI Governance")
  principle              String
  bestPractice           String   @map("best_practice")
  capabilities           String?
  details                String?
  thresholdPercentage    Float?   @map("threshold_percentage")        // null for qualitative controls
  metricDefinition       String?  @map("metric_definition")
  recommendationIfNotMet String?  @map("recommendation_if_not_met")
  fixActionEngine        String?  @map("fix_action_engine")           // e.g. comment-engine | tag-engine | estate-scan
  fixActionParamsJson    String?  @map("fix_action_params_json")
  evaluationType         String   @default("automatic") @map("evaluation_type") // automatic | qualitative
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  results ForgeWafControlResult[]

  @@index([pillar])
  @@map("forge_waf_controls")
}

