// Databricks Forge — Prisma Schema
//
// Connects to Lakebase Autoscaling (Postgres-compatible).
// Tables store pipeline run state, discovered use cases, and export history.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Pipeline Runs
// ---------------------------------------------------------------------------

model ForgeRun {
  runId              String    @id @map("run_id")
  businessName       String    @map("business_name")
  ucMetadata         String    @map("uc_metadata")
  excludedScope      String?   @map("excluded_scope")
  exclusionPatterns  String?   @map("exclusion_patterns")
  operation          String    @default("Discover Usecases")
  businessPriorities String?   @map("business_priorities")
  strategicGoals     String?   @map("strategic_goals")
  businessDomains    String?   @map("business_domains")
  aiModel            String?   @default("databricks-claude-opus-4-7") @map("ai_model")
  languages          String?   @default("[\"English\"]")
  generationOptions  String?   @default("[\"SQL Code\"]") @map("generation_options")
  generationPath     String?   @default("./forge_gen/") @map("generation_path")
  // Status values: pending | queued | running | completed | failed | cancelled
  // `queued` is set by the run-level scheduler when a user is at their
  // active-run cap (Phase 5b/5c). It transitions to `running` via the
  // atomic claim in lib/pipeline/scheduler.ts.
  status             String    @default("pending")
  currentStep        String?   @map("current_step")
  progressPct        Int       @default(0) @map("progress_pct")
  statusMessage      String?   @map("status_message")
  businessContext    String?   @map("business_context")
  errorMessage       String?   @map("error_message")
  createdAt          DateTime  @default(now()) @map("created_at")
  completedAt        DateTime? @map("completed_at")

  // Owner of this run (the user who created it). Nullable on legacy rows;
  // application code always writes a value for new rows. Cutover wipe
  // ensures no nulls remain after rollout.
  ownerEmail         String?   @map("owner_email")
  createdBy          String?   @map("created_by")
  filteredTablesJson String?   @map("filtered_tables_json")
  metadataCacheKey   String?   @map("metadata_cache_key")
  contextSourcesJson String?  @map("context_sources_json")
  schemaSnapshotJson String?  @map("schema_snapshot_json")
  synthesisJson      String?  @map("synthesis_json")
  // Provenance for the Executive Synthesis JSON above: which LLM endpoint
  // produced it and when. Surfaced as a "Generated by <model> on <date>"
  // footer on Business Value pages so consumers can tell Opus-quality
  // synthesis apart from earlier (mixed-pool) output.
  synthesisGeneratedByModel String?   @map("synthesis_generated_by_model")
  synthesisGeneratedAt      DateTime? @map("synthesis_generated_at")
  // JSON-encoded array of pipeline step ids that produced degraded output
  // (e.g. ["financial-quantification"]). Used by the UI to surface an
  // amber "Recompute" banner when an LLM call returned empty content and
  // could not be recovered via halve-batch + fallback. NULL = healthy.
  degradedStepsJson  String?  @map("degraded_steps_json")

  useCases             ForgeUseCase[]
  exports              ForgeExport[]
  promptLogs           ForgePromptLog[]
  genieRecommendations     ForgeGenieRecommendation[]
  genieSpaces              ForgeGenieSpace[]
  genieEngineConfigs       ForgeGenieEngineConfig[]
  dashboardRecommendations ForgeDashboardRecommendation[]
  dashboards               ForgeDashboard[]
  backgroundJobs           ForgeBackgroundJob[]
  environmentScans         ForgeEnvironmentScan[]
  discoveredGenieSpaces    ForgeDiscoveredGenieSpace[]
  discoveredDashboards     ForgeDiscoveredDashboard[]
  assetCoverages           ForgeAssetCoverage[]
  qualityMetrics           ForgeQualityMetric[]
  metricViewProposals      ForgeMetricViewProposal[]
  valueEstimates           ForgeValueEstimate[]
  roadmapPhases            ForgeRoadmapPhase[]
  useCaseTracking          ForgeUseCaseTracking[]
  valueCaptures            ForgeValueCapture[]
  strategyAlignments       ForgeStrategyAlignment[]
  stakeholderProfiles      ForgeStakeholderProfile[]

  @@index([ownerEmail])
  @@index([ownerEmail, status])
  @@index([ownerEmail, createdAt(sort: Desc)])
  @@map("forge_runs")
}

// ---------------------------------------------------------------------------
// Use Cases
// ---------------------------------------------------------------------------

model ForgeUseCase {
  id                 String  @id
  runId              String  @map("run_id")
  useCaseNo          Int?    @map("use_case_no")
  name               String?
  type               String?
  analyticsTechnique String? @map("analytics_technique")
  statement          String?
  solution           String?
  businessValue      String? @map("business_value")
  beneficiary        String?
  sponsor            String?
  domain             String?
  subdomain          String?
  tablesInvolved     String? @map("tables_involved")
  priorityScore          Float?  @map("priority_score")
  feasibilityScore       Float?  @map("feasibility_score")
  impactScore            Float?  @map("impact_score")
  overallScore           Float?  @map("overall_score")
  userPriorityScore      Float?  @map("user_priority_score")
  userFeasibilityScore   Float?  @map("user_feasibility_score")
  userImpactScore        Float?  @map("user_impact_score")
  userOverallScore       Float?  @map("user_overall_score")
  scoreRationale         String? @map("score_rationale")
  consultingScorecard    String? @map("consulting_scorecard")
  sqlCode                String? @map("sql_code")
  sqlStatus              String? @map("sql_status")
  feedback               String?                              // "accepted" | "rejected" | "dismissed"
  feedbackAt             DateTime? @map("feedback_at")
  enrichmentTags         String? @map("enrichment_tags")
  // ---- Source-system attribution (P3.1) ---------------------------------
  // JSON array of canonical source-system names (e.g. ["Salesforce","SAP"])
  // resolved by walking ForgeTableLineage upstream + pattern-matching the
  // root tables against TECH_TO_SYSTEM_MAP. Null when not yet computed.
  sourceSystems          String?   @map("source_systems")
  // Provenance for the attribution: "lineage" | "naming" | "comment" |
  // "mixed" | null. Helps the UI label confidence on derived chips.
  sourceSystemsOrigin    String?   @map("source_systems_origin")
  sourceSystemsResolvedAt DateTime? @map("source_systems_resolved_at")
  // ---- Downstream blast radius (P3.2) ----------------------------------
  // JSON blob carrying downstreamTableCount + entity-type breakdown + total
  // event count + the feasibility boost applied. Drives the "blast radius"
  // badge on use case cards and the BV stakeholder "high visibility" flag.
  blastRadiusJson        String?   @map("blast_radius_json")
  // ---- Master-repo reference link (Data Gap bridge) --------------------
  // Verbatim copy of the closest matching master-repository use case title
  // for this run's industry. Persisted so Data Gap (and any future surface
  // that needs to walk back to the master-repo namespace) can join on a
  // hard FK instead of fuzzy-matching the LLM-generated `name`.
  //
  // Populated by:
  //   1. Use case generation (LLM emits `reference_use_case_name` in the
  //      same JSON response — see `lib/ai/templates-usecase-gen.ts`).
  //   2. Lazy LLM backfill when Data Gap is first opened on a legacy run
  //      (see `lib/engines/data-gap-analysis/reference-backfill.ts`).
  // Null when no reference applies (deliberately uncoupled customer UC) or
  // when neither pass has been run yet.
  referenceUseCaseName       String?   @map("reference_use_case_name")
  referenceUseCaseResolvedAt DateTime? @map("reference_use_case_resolved_at")

  run ForgeRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([runId])
  @@index([runId, referenceUseCaseName])
  @@map("forge_use_cases")
}

// ---------------------------------------------------------------------------
// Prompt Audit Log
// ---------------------------------------------------------------------------

model ForgePromptLog {
  logId            String   @id @map("log_id")
  runId            String   @map("run_id")
  step             String
  promptKey        String   @map("prompt_key")
  promptVersion    String   @map("prompt_version")
  model            String
  temperature      Float
  renderedPrompt   String   @map("rendered_prompt")
  rawResponse      String?  @map("raw_response")
  honestyScore     Float?   @map("honesty_score")
  durationMs       Int?     @map("duration_ms")
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  totalTokens      Int?     @map("total_tokens")
  success          Boolean  @default(true)
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")

  run ForgeRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([runId])
  @@index([runId, step])
  @@map("forge_prompt_logs")
}

// ---------------------------------------------------------------------------
// Prompt Template Archive (content-addressable)
// ---------------------------------------------------------------------------

model ForgePromptTemplate {
  versionHash  String   @id @map("version_hash")
  promptKey    String   @map("prompt_key")
  templateText String   @map("template_text")
  charCount    Int      @map("char_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([promptKey])
  @@map("forge_prompt_templates")
}

// ---------------------------------------------------------------------------
// Activity Log
// ---------------------------------------------------------------------------

model ForgeActivityLog {
  activityId String   @id @map("activity_id")
  userId     String?  @map("user_id")
  action     String                              // created_run, deleted_run, exported, started_pipeline, completed, failed
  resourceId String?  @map("resource_id")        // runId or exportId
  metadata   String?                             // JSON metadata
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([resourceId])
  @@map("forge_activity_log")
}

// ---------------------------------------------------------------------------
// Metadata Cache
// ---------------------------------------------------------------------------

model ForgeMetadataCache {
  cacheKey     String   @id @map("cache_key")
  ucPath       String?  @map("uc_path")
  metadataJson String?  @map("metadata_json")
  tableCount   Int?     @map("table_count")
  columnCount  Int?     @map("column_count")
  cachedAt     DateTime @default(now()) @map("cached_at")

  @@index([cachedAt])
  @@map("forge_metadata_cache")
}

// ---------------------------------------------------------------------------
// Custom Outcome Maps
// ---------------------------------------------------------------------------

model ForgeOutcomeMap {
  id             String   @id @map("outcome_map_id")
  industryId     String   @unique @map("industry_id")
  name           String
  rawMarkdown    String   @map("raw_markdown")
  parsedJson     String   @map("parsed_json")
  enrichmentJson String?  @map("enrichment_json")
  useCaseCount   Int      @default(0) @map("use_case_count")
  createdBy      String?  @map("created_by")
  // Provenance for the LLM-generated enrichment payload. Records which
  // model produced the latest `enrichmentJson` and when, so the Outcome
  // Map browser can show "Generated by databricks-claude-opus-4-7" and
  // distinguish premium Opus output from older mixed-pool runs.
  generatedByModel String?   @map("generated_by_model")
  generatedAt      DateTime? @map("generated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("forge_outcome_maps")
}

// ---------------------------------------------------------------------------
// Genie Space Recommendations (generated in pipeline)
// ---------------------------------------------------------------------------

model ForgeGenieRecommendation {
  id                  String   @id @map("recommendation_id")
  runId               String   @map("run_id")
  domain              String
  subdomains          String?                              // JSON array
  title               String
  description         String
  tableCount          Int      @default(0) @map("table_count")
  metricViewCount     Int      @default(0) @map("metric_view_count")
  useCaseCount        Int      @default(0) @map("use_case_count")
  sqlExampleCount     Int      @default(0) @map("sql_example_count")
  joinCount           Int      @default(0) @map("join_count")
  measureCount        Int      @default(0) @map("measure_count")
  filterCount         Int      @default(0) @map("filter_count")
  dimensionCount      Int      @default(0) @map("dimension_count")
  tables              String?                              // JSON array of FQNs
  metricViews         String?  @map("metric_views")        // JSON array of FQNs
  serializedSpace     String   @map("serialized_space")    // JSON for Genie API
  benchmarks          String?                              // JSON: BenchmarkQuestion[]
  columnEnrichments   String?  @map("column_enrichments")  // JSON: ColumnEnrichment[]
  metricViewProposals String?  @map("metric_view_proposals") // JSON: MetricViewProposal[]
  trustedFunctions    String?  @map("trusted_functions")     // JSON: TrustedAssetFunction[]
  engineConfigVersion Int      @default(0) @map("engine_config_version")
  recommendationType  String   @default("new") @map("recommendation_type") // new | enhancement | replacement
  existingAssetId     String?  @map("existing_asset_id")
  changeSummary       String?  @map("change_summary")
  createdAt           DateTime @default(now()) @map("created_at")

  run ForgeRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId, domain])
  @@index([runId])
  @@map("forge_genie_recommendations")
}

// ---------------------------------------------------------------------------
// Metric View Proposals (standalone first-class artifacts)
// ---------------------------------------------------------------------------

model ForgeMetricViewProposal {
  id               String    @id @map("mv_proposal_id")
  runId            String?   @map("run_id")
  schemaScope      String    @map("schema_scope")
  domain           String?
  subdomain        String?
  name             String
  description      String?
  definitionJson   String?   @map("definition_json")
  yaml             String
  ddl              String
  sourceTablesJson String?   @map("source_tables_json")
  hasJoins         Boolean   @default(false) @map("has_joins")
  classification   String?   @map("classification")
  rationale        String?
  existingFqn      String?   @map("existing_fqn")
  improveDiffJson  String?   @map("improve_diff_json")
  improveBaseJson  String?   @map("improve_base_json")
  validationStatus String    @default("pending") @map("validation_status")
  validationIssues String?   @map("validation_issues")
  validatorVersion       String?   @map("validator_version")
  validationEvidenceJson String?   @map("validation_evidence_json")
  validatedAt            DateTime? @map("validated_at")
  deploymentStatus String    @default("proposed") @map("deployment_status")
  deployedFqn      String?   @map("deployed_fqn")
  deployedAt       DateTime? @map("deployed_at")
  ownerEmail       String?   @map("owner_email")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  run ForgeRun? @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([runId])
  @@index([schemaScope])
  @@index([deployedFqn])
  @@index([subdomain])
  @@index([ownerEmail])
  @@map("forge_metric_view_proposals")
}

// ---------------------------------------------------------------------------
// Genie Engine Configuration (per-run, customer-editable)
// ---------------------------------------------------------------------------

model ForgeGenieEngineConfig {
  id        String   @id @map("config_id")
  runId     String   @map("run_id")
  version   Int      @default(1)
  config    String                                       // JSON: GenieEngineConfig
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  run ForgeRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId])
  @@index([runId])
  @@map("forge_genie_engine_configs")
}

// ---------------------------------------------------------------------------
// Genie Spaces (tracking)
// ---------------------------------------------------------------------------

model ForgeGenieSpace {
  id                 String   @id @map("genie_tracking_id")
  spaceId            String   @unique @map("space_id")
  runId              String?  @map("run_id")
  domain             String
  title              String
  status             String   @default("created") // created | updated | trashed
  deployedAssetsJson String?  @map("deployed_assets_json")
  authMode           String?  @map("auth_mode") // "obo" | "sp" — null for legacy rows (treated as "sp")
  ownerEmail         String?  @map("owner_email")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  run ForgeRun? @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([runId])
  @@index([ownerEmail])
  @@index([ownerEmail, createdAt(sort: Desc)])
  @@map("forge_genie_spaces")
}

// ---------------------------------------------------------------------------
// Genie Space Cache (workspace listing cache for lazy loading)
// ---------------------------------------------------------------------------

model ForgeGenieSpaceCache {
  spaceId             String    @id @map("space_id")
  title               String
  description         String?
  tableCount          Int?      @map("table_count")
  measureCount        Int?      @map("measure_count")
  sampleQuestionCount Int?      @map("sample_question_count")
  filterCount         Int?      @map("filter_count")
  healthScore         Float?    @map("health_score")
  healthReportJson    String?   @map("health_report_json")
  permissionDenied    Boolean   @default(false) @map("permission_denied")
  lastDiscoveredAt    DateTime? @map("last_discovered_at")
  syncedAt            DateTime  @default(now()) @map("synced_at")

  @@map("forge_genie_space_cache")
}

// ---------------------------------------------------------------------------
// Dashboard Recommendations (generated in pipeline)
// ---------------------------------------------------------------------------

model ForgeDashboardRecommendation {
  id                  String   @id @map("recommendation_id")
  runId               String   @map("run_id")
  domain              String
  subdomains          String?                              // JSON array
  title               String
  description         String
  datasetCount        Int      @default(0) @map("dataset_count")
  widgetCount         Int      @default(0) @map("widget_count")
  useCaseIds          String?  @map("use_case_ids")        // JSON array
  serializedDashboard String   @map("serialized_dashboard") // Lakeview JSON
  dashboardDesign     String?  @map("dashboard_design")     // JSON: DashboardDesign
  designVersion       String?  @map("design_version")       // Nullable for legacy rows
  recommendationType  String   @default("new") @map("recommendation_type") // new | enhancement | replacement
  existingAssetId     String?  @map("existing_asset_id")
  improveDiffJson     String?  @map("improve_diff_json")
  improveBaseJson     String?  @map("improve_base_json")
  changeSummary       String?  @map("change_summary")
  ownerEmail              String?   @map("owner_email")
  datasetSourceKind       String?   @map("dataset_source_kind")
  publicationStatus       String?   @map("publication_status")
  publishedAt             DateTime? @map("published_at")
  validationStatus        String    @default("pending") @map("validation_status")
  validatorVersion        String?   @map("validator_version")
  validationEvidenceJson  String?   @map("validation_evidence_json")
  validatedAt             DateTime? @map("validated_at")
  createdAt           DateTime @default(now()) @map("created_at")

  run ForgeRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId, domain])
  @@index([runId])
  @@index([ownerEmail])
  @@map("forge_dashboard_recommendations")
}

// ---------------------------------------------------------------------------
// Dashboards (tracking)
// ---------------------------------------------------------------------------

model ForgeDashboard {
  id           String   @id @map("dashboard_tracking_id")
  dashboardId  String   @map("dashboard_id")
  runId        String   @map("run_id")
  domain       String
  title        String
  status       String   @default("created") // created | updated | trashed
  dashboardUrl String?  @map("dashboard_url")
  publicationStatus String?   @map("publication_status")
  publishedAt       DateTime? @map("published_at")
  embedCredentials  Boolean   @default(false) @map("embed_credentials")
  ownerEmail         String?   @map("owner_email")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  run ForgeRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId, domain])
  @@index([runId])
  @@index([dashboardId])
  @@index([ownerEmail])
  @@map("forge_dashboards")
}

// ---------------------------------------------------------------------------
// Background Jobs (engine status persistence)
// ---------------------------------------------------------------------------

model ForgeBackgroundJob {
  id          String    @id @map("job_id")
  runId       String    @map("run_id")
  engine      String    // "genie" | "dashboard" | "scan"
  status      String    @default("generating")
  message     String    @default("")
  percent     Int       @default(0)
  startedAt   DateTime  @map("started_at")
  completedAt DateTime? @map("completed_at")
  error       String?
  detailsJson String?   @map("details_json")
  domainCount Int       @default(0) @map("domain_count")

  run ForgeRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId, engine])
  @@index([runId])
  @@map("forge_background_jobs")
}

// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------

model ForgeExport {
  exportId  String   @id @map("export_id")
  runId     String   @map("run_id")
  format    String
  filePath  String?  @map("file_path")
  createdAt DateTime @default(now()) @map("created_at")

  run ForgeRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([runId])
  @@map("forge_exports")
}

// ---------------------------------------------------------------------------
// Environment Scans
// ---------------------------------------------------------------------------

model ForgeEnvironmentScan {
  scanId                String   @id @map("scan_id")
  runId                 String?  @map("run_id")
  programId             String?  @map("program_id")
  ucPath                String   @map("uc_path")
  excludedScope         String?  @map("excluded_scope")
  exclusionPatterns     String?  @map("exclusion_patterns")
  inclusionPatterns     String?  @map("inclusion_patterns")
  tableCount            Int      @default(0) @map("table_count")
  totalSizeBytes        BigInt   @default(0) @map("total_size_bytes")
  totalFiles            Int      @default(0) @map("total_files")
  totalRows             BigInt   @default(0) @map("total_rows")
  tablesWithStreaming    Int      @default(0) @map("tables_with_streaming")
  tablesWithCDF         Int      @default(0) @map("tables_with_cdf")
  tablesNeedingOptimize Int      @default(0) @map("tables_needing_optimize")
  tablesNeedingVacuum   Int      @default(0) @map("tables_needing_vacuum")
  lineageDiscoveredCount Int     @default(0) @map("lineage_discovered_count")
  domainCount           Int      @default(0) @map("domain_count")
  piiTablesCount        Int      @default(0) @map("pii_tables_count")
  redundancyPairsCount  Int      @default(0) @map("redundancy_pairs_count")
  dataProductCount      Int      @default(0) @map("data_product_count")
  avgGovernanceScore    Float    @default(0) @map("avg_governance_score")
  scanDurationMs        Int?     @map("scan_duration_ms")
  scanSummaryJson       String?  @map("scan_summary_json")
  passResultsJson       String?  @map("pass_results_json")
  genieSpaceCount       Int      @default(0) @map("genie_space_count")
  dashboardCount        Int      @default(0) @map("dashboard_count")
  metricViewCount       Int      @default(0) @map("metric_view_count")
  analyticsCoveragePercent Float @default(0) @map("analytics_coverage_percent")
  // Provenance for cross-team / cross-workspace portfolio roll-up (V2).
  // Stamped from the owning Estate Scope at scan time.
  workspaceId          String?  @map("workspace_id")
  teamLabel            String?  @map("team_label")
  // Durability: distinguishes a fully-saved scan from a checkpoint that is
  // still running or that failed mid-flight. Legacy rows (written before this
  // column existed) default to `complete` so historical scans keep counting.
  // Estate aggregates / Excel / Portfolio / reconstitution exclude anything
  // that is not `complete`.
  scanStatus            String   @default("complete") @map("scan_status")
  startedAt             DateTime? @map("started_at")
  finishedAt            DateTime? @map("finished_at")
  createdAt             DateTime @default(now()) @map("created_at")
  ownerEmail            String?  @map("owner_email")

  run            ForgeRun? @relation(fields: [runId], references: [runId], onDelete: Cascade)
  program        ForgeEstateProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  details        ForgeTableDetail[]
  histories      ForgeTableHistorySummary[]
  lineage        ForgeTableLineage[]
  insights       ForgeTableInsight[]
  domainOverrides ForgeDomainOverride[]
  dataGapAnalyses ForgeDataGapAnalysis[]
  syntheses      ForgeEstateSynthesis[]

  @@index([runId])
  @@index([programId])
  @@index([createdAt])
  @@index([ownerEmail])
  @@index([ownerEmail, createdAt(sort: Desc)])
  @@index([scanStatus])
  @@map("forge_environment_scans")
}

// ---------------------------------------------------------------------------
// Estate Programs (company-level grouping + planned scan sequence)
// ---------------------------------------------------------------------------

/**
 * A company-level estate engagement (e.g. "Petronas"). Groups many estate
 * scans into one aggregate view and owns a planned scan sequence
 * (ForgeEstateProgramScope) so a large estate can be scanned in many passes.
 */
model ForgeEstateProgram {
  id          String   @id @default(uuid()) @map("program_id")
  name        String
  description String?
  industryId  String?  @map("industry_id")
  subVertical String?  @map("sub_vertical")
  orgContext  String?  @map("org_context")
  ownerEmail  String?  @map("owner_email")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  scopes ForgeEstateProgramScope[]
  scans  ForgeEnvironmentScan[]

  @@index([ownerEmail])
  @@index([ownerEmail, createdAt(sort: Desc)])
  @@map("forge_estate_programs")
}

/**
 * One planned scan target within a program's sequence. Maps a UC scope
 * (catalog/schema list) to the scan it produced. `status` drives the
 * orchestrated run; `sequence` orders the planned passes.
 */
model ForgeEstateProgramScope {
  id                   String   @id @default(uuid()) @map("scope_id")
  programId            String   @map("program_id")
  label                String
  ucMetadata           String   @map("uc_metadata")
  excludedScope        String?  @map("excluded_scope")
  exclusionPatterns    String?  @map("exclusion_patterns")
  inclusionPatterns    String?  @map("inclusion_patterns")
  assetDiscoveryEnabled Boolean @default(false) @map("asset_discovery_enabled")
  lineageDepth         Int      @default(5) @map("lineage_depth")
  lineageEnabled       Boolean  @default(true) @map("lineage_enabled")
  lineageDirection     String   @default("upstream") @map("lineage_direction")
  // Provenance for cross-team / cross-workspace portfolio roll-up (V2).
  workspaceId          String?  @map("workspace_id")
  teamLabel            String?  @map("team_label")
  // Status machine: planned | queued | running | complete | failed | paused | cancelled
  status               String   @default("planned")
  // The scan this scope produced (or is producing). A plain id, NOT a FK:
  // it is set at claim time so the UI can poll live scan progress, before the
  // ForgeEnvironmentScan row exists. A FK here would fire on that early write.
  scanId               String?  @map("scan_id")
  // Identity of the process-local deferred queue entry. The queue refreshes
  // heartbeatAt while this job remains legitimately delayed; after a process
  // restart that lease expires and the orphaned queued scope is reclaimable.
  queueJobId            String?  @map("queue_job_id")
  sequence             Int      @default(0)
  errorMessage         String?  @map("error_message")
  // Durable state-machine bookkeeping. `attemptCount` bounds retries
  // (MAX_SCOPE_ATTEMPTS); the timestamps track the lifecycle and drive
  // stale-work reclaim (heartbeatAt beyond a threshold => the worker is gone).
  attemptCount         Int      @default(0) @map("attempt_count")
  queuedAt             DateTime? @map("queued_at")
  startedAt            DateTime? @map("started_at")
  heartbeatAt          DateTime? @map("heartbeat_at")
  finishedAt           DateTime? @map("finished_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  program ForgeEstateProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  // Deterministic ordering AND a hard guarantee that no two scopes in a
  // program share a sequence. Sequence is allocated transactionally on insert.
  @@unique([programId, sequence])
  @@map("forge_estate_program_scopes")
}

