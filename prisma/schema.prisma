model ForgeStakeholderProfile {
  id               String   @id @default(uuid()) @map("profile_id")
  runId            String   @map("run_id")
  role             String
  department       String
  useCaseCount     Int      @default(0) @map("use_case_count")
  totalValue       Float    @default(0) @map("total_value")
  domains          String?  // JSON array of domain names
  useCaseTypes     String?  @map("use_case_types") // JSON: { AI: n, Statistical: n, Geospatial: n }
  // JSON array of use case ids this stakeholder is linked to. Today the
  // LLM emits these IDs and the BV pass uses them to compute totalValue,
  // then drops them on persistence -- which breaks Stakeholder ->
  // Use-Case drill-down. Persisted here so a click on a stakeholder row
  // can resolve back to the specific use cases they own / sponsor.
  useCaseIds       String?  @map("use_case_ids")
  changeComplexity String?  @map("change_complexity") // low | medium | high
  isChampion       Boolean  @default(false) @map("is_champion")
  isSponsor        Boolean  @default(false) @map("is_sponsor")
  // ---- LLM-generated narrative rationale (Phase 1.5) ---------------------
  // Concrete justifications that prevent the recommendation cards from
  // reading as opaque labels. `championRationale` explains why this person
  // is a recommended change champion; `complexityRationale` explains why
  // the change is rated low/medium/high; `keyRisks` is a JSON array of
  // 1-3 organisational risks the stakeholder should expect.
  championRationale   String?  @map("champion_rationale")
  complexityRationale String?  @map("complexity_rationale")
  keyRisks            String?  @map("key_risks") // JSON array of risk strings
  // ---- Provenance --------------------------------------------------------
  generatedByModel String?   @map("generated_by_model")
  generatedAt      DateTime? @map("generated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  run ForgeRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([runId])
  @@index([department])
  @@map("forge_stakeholder_profiles")
}

