model ForgeValueEstimate {
  id              String   @id @default(uuid()) @map("estimate_id")
  runId           String   @map("run_id")
  useCaseId       String   @map("use_case_id")
  valueLow        Float    @map("value_low")
  valueMid        Float    @map("value_mid")
  valueHigh       Float    @map("value_high")
  currency        String   @default("USD")
  valueType       String   @map("value_type") // cost_savings | revenue_uplift | risk_reduction | efficiency_gain
  confidence      String   @default("medium") // low | medium | high
  rationale       String?
  assumptions     String?  // JSON array of assumption strings
  industryBenchmark String? @map("industry_benchmark")
  // ---- Master Repository v2 economic pattern fields (optional) -----------
  economicPatternName     String? @map("economic_pattern_name")
  economicImpactCategory  String? @map("economic_impact_category")
  economicFormulaVars     String? @map("economic_formula_vars") // JSON object: variable -> value
  // ---- Provenance --------------------------------------------------------
  // The LLM endpoint that produced this estimate and when. Persisted on
  // every upsert so the BV page can show "Generated by databricks-claude-opus-4-7
  // on <date>" instead of leaving the customer to wonder if the number
  // came from Opus or a flash-lite degradation.
  generatedByModel String?   @map("generated_by_model")
  generatedAt      DateTime? @map("generated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  run ForgeRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId, useCaseId])
  @@index([runId])
  @@map("forge_value_estimates")
}

