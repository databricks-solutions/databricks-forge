// ---------------------------------------------------------------------------
// User Isolation: Resource Access Control List
//
// Owners share their resources (runs, scans, Genie spaces, demo sessions, etc.)
// with named teammates by writing rows here. Visibility queries everywhere
// follow the rule:
//
//   user can see resource R if R.owner_email = $user
//                         OR exists ACL row (resource_type, R.id, $user)
//
// Permission semantics:
//   view  -- can read; cannot regenerate, edit metadata, delete, or re-share
//   edit  -- view + can re-run / regenerate / edit metadata
//   (owner is implicit on the resource itself; not stored here)
// ---------------------------------------------------------------------------

model ForgeResourceAcl {
  id           String   @id @default(uuid())
  // run | scan | genie_space | metadata_genie_space | demo_session |
  // comment_job | strategy_document | connection | document |
  // bv_portfolio | benchmark_run | health_score | metric_view_proposal |
  // fabric_scan | fabric_migration
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  viewerEmail  String   @map("viewer_email")
  permission   String   @default("view") // "view" | "edit"
  grantedBy    String   @map("granted_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([resourceType, resourceId, viewerEmail])
  @@index([viewerEmail, resourceType])
  @@index([resourceType, resourceId])
  @@map("forge_resource_acl")
}

// ---------------------------------------------------------------------------
// User Isolation: Per-User Usage Counters (Phase 5b)
//
// Read-only telemetry written by the rate limiter and pipeline engine to
// support fairness reporting and a future hard quota. One row per
// (userEmail, day) -- aggregated across all engines.
// ---------------------------------------------------------------------------

model ForgeUsage {
  id           String   @id @default(uuid())
  userEmail    String   @map("user_email")
  day          DateTime @map("day") @db.Date
  pipelineRuns Int      @default(0) @map("pipeline_runs")
  scans        Int      @default(0) @map("scans")
  genieDeploys Int      @default(0) @map("genie_deploys")
  demoEngines  Int      @default(0) @map("demo_engines")
  llmCalls     Int      @default(0) @map("llm_calls")
  embedTokens  Int      @default(0) @map("embed_tokens")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userEmail, day])
  @@index([userEmail])
  @@index([day])
  @@map("forge_usage")
}

