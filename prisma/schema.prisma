  createdAt      DateTime @default(now()) @map("created_at")

  scan ForgeEnvironmentScan @relation(fields: [scanId], references: [scanId], onDelete: Cascade)

  @@unique([scanId, scope, target], name: "scan_override")
  @@index([scanId])
  @@map("forge_domain_overrides")
}

