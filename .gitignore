# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (never commit binaries / reports / traces)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# cursor IDE rules (local only)
.cursor/

# zero-egress deploy packages (generated by deploy.sh --zero-egress)
/.deploy-pkg/
/.deploy-pkg-ze/

# mkdocs build output and venv
/site/
/.venv-docs/

# internal docs (removed for public release)
FORGE_V1_vs_V2.md
docs/outcome maps/
docs/references/
errors.json
.databricks/

# local agent planning and execution artifacts
/.claude/
/.superpowers/
/docs/superpowers/
/docs/audit/
